import pandas as pd
import yfinance as yf
import requests
from concurrent.futures import ThreadPoolExecutor, as_completed


def fetch_nse_symbols() -> list[str]:
    """Fetch NSE equity symbols for the NIFTY 500 universe.
    The official NSE endpoint is used when available; if it fails,
    a fallback list can be supplied here.
    """
    headers = {
        "User-Agent": "Mozilla/5.0",
        "Accept-Language": "en-US,en;q=0.9",
        "Accept": "application/json, text/plain, */*",
    }

    url = "https://www.nseindia.com/api/equity-stockIndices?index=NIFTY%20500"
    session = requests.Session()
    try:
        session.get("https://www.nseindia.com", headers=headers, timeout=20)
        response = session.get(url, headers=headers, timeout=30)
        response.raise_for_status()
        data = response.json()
        symbols = [item.get("symbol") for item in data.get("data", []) if item.get("symbol")]
        return [f"{symbol}.NS" for symbol in symbols]
    except Exception:
        # Fallback: manually add well-known tickers if the live NSE API is unavailable.
        return [
            "RELIANCE", "TCS.NS", "INFY.NS", "HDFCBANK.NS", "ICICIBANK.NS",
            "SBIN.NS", "LTIM.NS", "ITC.NS", "BHARTIARTL.NS", "SUNPHARMA.NS",
            "KOTAKBANK.NS", "HINDUNILVR.NS", "WIPRO.NS", "TITAN.NS", "ASIANPAINT.NS",
        ]


def calculate_monthly_macd(history: pd.DataFrame) -> pd.DataFrame:
    """Calculate monthly MACD values for a stock's price history."""
    if history.empty:
        return pd.DataFrame()

    monthly = history[["Close"]].resample("ME").last().dropna()
    if monthly.empty:
        return pd.DataFrame()

    ema_12 = monthly["Close"].ewm(span=12, adjust=False).mean()
    ema_26 = monthly["Close"].ewm(span=26, adjust=False).mean()
    macd = ema_12 - ema_26
    signal = macd.ewm(span=9, adjust=False).mean()
    histogram = macd - signal

    result = pd.DataFrame(
        {
            "month": monthly.index,
            "close": monthly["Close"].values,
            "macd": macd.values,
            "signal": signal.values,
            "histogram": histogram.values,
        }
    )
    return result


def compute_symbol_macd(symbol: str) -> pd.DataFrame:
    """Download price history and calculate monthly MACD for one NSE ticker."""
    data = yf.download(
        symbol,
        period="10y",
        interval="1d",
        auto_adjust=True,
        progress=False,
        group_by="ticker",
        threads=True,
    )

    if data.empty:
        return pd.DataFrame()

    result = calculate_monthly_macd(data)
    if result.empty:
        return result

    result["symbol"] = symbol
    return result


def main() -> None:
    tickers = fetch_nse_symbols()
    print(tickers)

    tcs_data = yf.download(
        symbol="TCS.NS",
        period="10y",
        interval="1d",
        auto_adjust=True,
        progress=False,
        group_by="ticker",
        threads=True,
    )
    print(tcs_data.head())
    
    all_results = []

    with ThreadPoolExecutor(max_workers=8) as executor:
        futures = [executor.submit(compute_symbol_macd, ticker) for ticker in tickers]
        for future in as_completed(futures):
            try:
                df = future.result()
                if not df.empty:
                    all_results.append(df)
            except Exception as exc:
                print(f"Error processing symbol: {exc}")

    if not all_results:
        print("No MACD data was generated.")
        return

    final_df = pd.concat(all_results, ignore_index=True)
    output_path = "nse_monthly_macd.csv"
    final_df.to_csv(output_path, index=False)
    print(f"Saved monthly MACD values for {len(final_df['symbol'].unique())} NSE symbols to {output_path}")


if __name__ == "__main__":
    main()
